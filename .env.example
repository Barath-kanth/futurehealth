# GCP project (already used: futurehealth-514508)
GOOGLE_CLOUD_PROJECT=futurehealth-514508
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VERTEX_MODEL=gemini-2.0-flash-001

# Persistence: memory | gcp  (Cloud Run sets AGENT_PERSIST=gcp)
AGENT_PERSIST=memory
FIRESTORE_COLLECTION=seedshield
BQ_DATASET=seedshield_events
BQ_TABLE=agent_events
BQ_LOCATION=US

# Optional: Next.js proxies agent cycles to Cloud Run
# AGENT_PLATFORM_URL=https://seedshield-agents-xxxxx.run.app
# AGENT_PLATFORM_TOKEN=
AGENT_SCHEDULER_SECRET=seedshield-scheduler-demo
